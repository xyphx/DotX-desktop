<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:DotX.Desktop.ViewModels.Components"
             x:DataType="vm:DocumentUploadViewModel"
             x:Class="DotX.Desktop.Controls.DocumentUploadControl"
             x:Name="RootControl">
    <StackPanel Spacing="32" Margin="0,16,0,0">
        <!-- Step Header -->
        <Grid ColumnDefinitions="*, Auto">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="01. Document Upload" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" LetterSpacing="0.5" />
                <TextBlock Text="Attach architectural guidelines and product requirements." FontSize="13" Foreground="{StaticResource TextLightBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="Outline" Content="View Guidelines" VerticalAlignment="Top" Padding="12,6" FontSize="12" />
        </Grid>

        <!-- Document List -->
        <ItemsControl ItemsSource="{Binding Documents}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="4,0" Padding="16">
                        <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
                            
                            <!-- Header (Title & Badge) -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDarkBrush}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="Required" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            
                            <!-- Description -->
                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextLightBrush}" TextWrapping="Wrap" Margin="0,0,0,24" MinHeight="48" />
                            
                            <!-- Drop Area (Now a Button) -->
                            <Button Grid.Row="2" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16" HorizontalAlignment="Stretch" Cursor="Hand" Command="{ReflectionBinding $parent[UserControl].DataContext.SelectFileCommand}" CommandParameter="{Binding}">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Select File" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="PDF, DOCX, TXT" FontSize="10" Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            
                            <!-- Uploaded File -->
                            <Border Grid.Row="4" Background="{StaticResource CardBackgroundBrush}" CornerRadius="4" Padding="12" IsVisible="{Binding IsUploaded}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextDarkBrush}" />
                                        <TextBlock Text="{Binding FileSize}" FontSize="10" Foreground="{StaticResource TextLightBrush}" />
                                    </StackPanel>
                                    <materialIcons:MaterialIcon Grid.Column="1" Kind="Check" Foreground="{StaticResource SuccessBrush}" Width="16" Height="16" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Footer Actions -->
        <Grid ColumnDefinitions="Auto, *, Auto" Margin="4,16,4,0">
            <Button Grid.Column="0" Classes="Outline" Content="Validate" Padding="16,8" FontSize="12" Command="{Binding ValidateCommand}" />
            <Button Grid.Column="2" Classes="Primary" Content="Proceed to Agents" Padding="16,8" FontSize="12" Command="{Binding ProceedCommand}" />
        </Grid>
    </StackPanel>
</UserControl>
