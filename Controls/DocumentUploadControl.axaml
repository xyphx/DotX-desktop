<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:DotX.Desktop.ViewModels.Components"
             x:DataType="vm:DocumentUploadViewModel"
             x:Class="DotX.Desktop.Controls.DocumentUploadControl"
             x:Name="RootControl">
    <StackPanel Spacing="32" Margin="0,16,0,0">
        <!-- Step Header -->
        <Grid ColumnDefinitions="*, Auto">
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                <TextBlock Text="01. Document Upload" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" LetterSpacing="0.5" TextWrapping="Wrap" />
                <TextBlock Text="Attach architectural guidelines and product requirements." FontSize="13" Foreground="{StaticResource TextLightBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="Outline" Content="View Guidelines" VerticalAlignment="Top" Padding="12,6" FontSize="12" />
        </Grid>

        <!-- Document List -->
        <ItemsControl ItemsSource="{Binding Documents}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,16,16" Padding="16" MinWidth="220" MaxWidth="340" Width="260">
                        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto">
                            
                            <!-- Header (Title & Badge) -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDarkBrush}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            
                            <!-- Description -->
                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextLightBrush}" TextWrapping="Wrap" Margin="0,0,0,24" MinHeight="48" />
                            
                            <!-- Drop Area (Select Button) -->
                            <Button Grid.Row="2" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,12" HorizontalAlignment="Stretch" Cursor="Hand" Command="{ReflectionBinding $parent[UserControl].DataContext.SelectFileCommand}" CommandParameter="{Binding}" IsEnabled="{Binding !IsUploading}">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Select File" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="PDF, DOCX, TXT" FontSize="10" Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Uploading Indicator -->
                            <Border Grid.Row="3" Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,12" IsVisible="{Binding IsUploading}">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True" Width="140" Height="4" Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Text="Uploading to cloud storage..." FontSize="11" Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Error Message Banner -->
                            <Border Grid.Row="3" Background="#2A1517" BorderBrush="#E54D2E" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,12" IsVisible="{Binding HasError}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Grid.Column="0" Text="⚠" Foreground="#E54D2E" VerticalAlignment="Top" Margin="0,0,6,0" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="#FF8585" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            
                            <!-- Uploaded File Display -->
                            <Border Grid.Row="4" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" IsVisible="{Binding IsUploaded}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextDarkBrush}" />
                                        <TextBlock Text="{Binding FileSize}" FontSize="10" Foreground="{StaticResource TextLightBrush}" />
                                    </StackPanel>
                                    <materialIcons:MaterialIcon Grid.Column="1" Kind="CheckCircle" Foreground="{StaticResource SuccessBrush}" Width="18" Height="18" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Footer Actions -->
        <WrapPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Classes="Outline" Content="Validate" Padding="16,8" FontSize="12" Command="{Binding ValidateCommand}" Margin="0,0,12,8" />
            <Button Classes="Primary" Content="Proceed to Agents" Padding="16,8" FontSize="12" Command="{Binding ProceedCommand}" Margin="0,0,0,8" />
        </WrapPanel>
    </StackPanel>
</UserControl>
