<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DotX.Desktop.App"
             xmlns:local="using:DotX.Desktop"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DotX.Desktop/Styles/ColorResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles />
        
        <StyleInclude Source="avares://DotX.Desktop/Styles/ButtonStyles.axaml" />
        <StyleInclude Source="avares://DotX.Desktop/Styles/CardStyles.axaml" />
    </Application.Styles>
</Application>