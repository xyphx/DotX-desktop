<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DotX.Desktop.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:DotX.Desktop.ViewModels"
             x:DataType="vm:DashboardViewModel"
             x:Class="DotX.Desktop.Views.DashboardView">
    <Grid RowDefinitions="Auto, *">
        <!-- Top Menu Bar -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="8">
                    <Button Command="{Binding ToggleSidebarCommand}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand">
                        <materialIcons:MaterialIcon Kind="Menu" Width="20" Height="20" Foreground="{StaticResource TextDarkBrush}" />
                    </Button>
                    <Menu>
                        <Menu.Styles>
                            <Style Selector="MenuItem">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="MinHeight" Value="30" />
                            </Style>
                        </Menu.Styles>
                        <MenuItem Header="File" />
                        <MenuItem Header="Edit" />
                        <MenuItem Header="Selection" />
                        <MenuItem Header="View" />
                        <MenuItem Header="Go" />
                        <MenuItem Header="Run" />
                        <MenuItem Header="Terminal" />
                        <MenuItem Header="Help" />
                    </Menu>
                </StackPanel>
                
                <TextBlock Text="desktop - DotX IDE - Project.axaml" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           FontSize="12" 
                           Foreground="{StaticResource TextLightBrush}" />
            </Grid>
        </Border>
        
        <SplitView Grid.Row="1" IsPaneOpen="{Binding IsSidebarOpen}" DisplayMode="CompactInline" OpenPaneLength="250" CompactPaneLength="0">
            <SplitView.Pane>
                <!-- Sidebar -->
                <controls:SidebarControl DataContext="{Binding Sidebar}" />
            </SplitView.Pane>
            
            <SplitView.Content>
                <!-- Main Content Area -->
                <TransitioningContentControl Content="{Binding CurrentPage}" />
            </SplitView.Content>
        </SplitView>
        
        <!-- Notification Toast -->
        <Border Grid.Row="1" Background="{StaticResource PrimaryBrush}" 
                CornerRadius="8" Padding="16,12" 
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                IsVisible="{Binding IsNotificationVisible}"
                ZIndex="100"
                BoxShadow="0 4 12 0 #40000000">
            <TextBlock Text="{Binding NotificationMessage}" Foreground="White" FontWeight="SemiBold" FontSize="14" />
        </Border>
    </Grid>
</UserControl>
