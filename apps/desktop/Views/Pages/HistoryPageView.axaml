<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:DotX.Desktop.ViewModels.Pages"
             x:DataType="vm:HistoryPageViewModel"
             x:Class="DotX.Desktop.Views.Pages.HistoryPageView">
    
    <Grid RowDefinitions="Auto, *" Margin="32">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Text="Prompt History" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" LetterSpacing="0.5" />
            <TextBlock Text="Review the history of prompts you've sent to your AI agents." FontSize="13" Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Prompts List -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Prompts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBackgroundBrush}" 
                                BorderBrush="{StaticResource BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="20" 
                                Margin="0,0,0,16"
                                BoxShadow="0 2 8 0 #05000000">
                            
                            <Grid RowDefinitions="Auto, Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                                    <Border Background="{StaticResource SidebarBackgroundBrush}" CornerRadius="6" Padding="6">
                                        <materialIcons:MaterialIcon Kind="Terminal" Width="16" Height="16" Foreground="{StaticResource PrimaryBrush}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AgentUsed}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDarkBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Timestamp}" FontSize="11" Foreground="{StaticResource TextLightBrush}" />
                                            <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextLightBrush}" />
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                
                                <TextBlock Grid.Row="1" Text="{Binding PromptText}" FontSize="14" Foreground="{StaticResource TextDarkBrush}" TextWrapping="Wrap" LineHeight="20" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
