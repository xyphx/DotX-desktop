<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DotX.Desktop.ViewModels"
             x:DataType="vm:LoginViewModel"
             x:Class="DotX.Desktop.Views.LoginView">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Border Classes="Card" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,48" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <StackPanel Spacing="24">
                <!-- Logo -->
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Image Source="/Assets/logo.png" Width="56" Height="56" />
                    <TextBlock Text="DotX" FontWeight="Bold" FontSize="36" VerticalAlignment="Center" Foreground="{StaticResource TextDarkBrush}"/>
                </StackPanel>

                <!-- Instructions -->
                <TextBlock Text="Sign in to continue" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,16"/>
                
                <StackPanel Spacing="8" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="•" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock Text="Go to xyphx.com and log into the console." FontSize="13" Foreground="{StaticResource TextLightBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="•" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock Text="Generate a new API key from your dashboard." FontSize="13" Foreground="{StaticResource TextLightBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="•" FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                        <TextBlock Text="Paste the key below to authenticate." FontSize="13" Foreground="{StaticResource TextLightBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <!-- Action Button to Open Web -->
                <Button Classes="Outline" HorizontalAlignment="Stretch" Command="{Binding OpenConsoleCommand}" Padding="0,10">
                    <TextBlock Text="Open XyphX Console" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                </Button>

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,8"/>

                <!-- API Key Input -->
                <StackPanel Spacing="8">
                    <TextBlock Text="API Key" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}"/>
                    <TextBox Text="{Binding ApiKey}" Watermark="Paste your API key here..." PasswordChar="•" FontSize="13" Padding="12" CornerRadius="6" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                </StackPanel>

                <!-- Login Button -->
                <Button Classes="Primary" Content="Login" HorizontalAlignment="Stretch" Padding="0,12" FontSize="14" FontWeight="Bold" Command="{Binding LoginCommand}" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
