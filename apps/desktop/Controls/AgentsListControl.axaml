<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:DotX.Desktop.ViewModels.Components"
             x:DataType="vm:AgentsListViewModel"
             x:Class="DotX.Desktop.Controls.AgentsListControl">
    <Border Classes="Card" Padding="20">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="AI Agents That Will Be Generated" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Based on your requirements, .X will create the following agents:" FontSize="12" Foreground="{StaticResource TextLightBrush}" TextWrapping="Wrap" />
            </StackPanel>
            
            <ItemsControl ItemsSource="{Binding Agents}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,16">
                            <Border Grid.Column="0" Background="#F0F9FF" CornerRadius="8" Width="40" Height="40" VerticalAlignment="Top">
                                <materialIcons:MaterialIcon Kind="{Binding Icon}" Foreground="{StaticResource PrimaryBrush}" Width="20" Height="20" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDarkBrush}" />
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextLightBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="#EEF2FF" CornerRadius="4" Padding="8,4" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
            <Button Classes="Outline" HorizontalAlignment="Stretch" BorderThickness="0" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="Grid" Width="16" Height="16" />
                    <TextBlock Text="View All Agents" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
