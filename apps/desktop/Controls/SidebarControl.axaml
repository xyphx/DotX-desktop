<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:DotX.Desktop.ViewModels.Components"
             x:DataType="vm:SidebarViewModel"
             x:Class="DotX.Desktop.Controls.SidebarControl">
    <Border Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="0,16,0,16">
            <!-- Header Section (Logo + New Project) -->
            <StackPanel Grid.Row="0" Margin="16,0,16,32">
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
                    <Image Source="/Assets/logo.png" Width="48" Height="48" />
                    <TextBlock Text="DotX" FontWeight="Bold" FontSize="24" VerticalAlignment="Center" Foreground="{StaticResource TextDarkBrush}"/>
                </StackPanel>

                <Button Classes="Primary" HorizontalAlignment="Stretch" Command="{Binding NewProjectCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                        <TextBlock Text="New Project" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Navigation List -->
            <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent" Margin="8,2">
                            <!-- Subtle highlight for active state -->
                            <Border Background="{StaticResource CardBackgroundBrush}" 
                                    IsVisible="{Binding IsActive}" 
                                    CornerRadius="6" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,8">
                                <materialIcons:MaterialIcon Kind="{Binding Icon}" 
                                                          Width="16" Height="16" 
                                                          Foreground="{Binding IsActive, Converter={x:Static ObjectConverters.IsNull}}" /> 
                                <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" 
                                         Foreground="{Binding IsActive, Converter={x:Static ObjectConverters.IsNull}}" /> 
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="32"/>
                    </Style>
                </ListBox.Styles>
            </ListBox>

            <!-- Inline Pro Upgrade -->
            <StackPanel Grid.Row="2" Margin="16,16,16,24" Spacing="8">
                <TextBlock Text="Unlock .X Pro" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" />
                <TextBlock Text="Advanced agents and private workspaces." FontSize="11" Foreground="{StaticResource TextLightBrush}" TextWrapping="Wrap" />
                <Button Content="Upgrade" Classes="Outline" HorizontalAlignment="Left" Padding="12,6" FontSize="11" Command="{Binding UpgradeCommand}" />
            </StackPanel>

            <!-- Footer Section -->
            <StackPanel Grid.Row="3" Margin="16,0,16,0" Spacing="16">
                <!-- Help -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <materialIcons:MaterialIcon Kind="HelpCircleOutline" Width="16" Height="16" Foreground="{StaticResource TextLightBrush}" />
                    <TextBlock Text="Support" FontSize="13" Foreground="{StaticResource TextLightBrush}" />
                </StackPanel>

                <!-- Profile -->
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Border Grid.Column="0" Background="{StaticResource BorderBrush}" CornerRadius="4" Width="24" Height="24">
                        <TextBlock Text="SD" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource TextDarkBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Sidharth" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDarkBrush}" />
                    </StackPanel>
                    <materialIcons:MaterialIcon Grid.Column="2" Kind="UnfoldMoreHorizontal" Width="16" Height="16" Foreground="{StaticResource TextLightBrush}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
