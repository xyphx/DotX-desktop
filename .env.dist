APP_NAME=codflo
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=info

# Network and ports
CLIENT_HOST=0.0.0.0
CLIENT_PORT=3000

SERVER_HOST=0.0.0.0
SERVER_PORT=5000

AGENT_HOST=0.0.0.0
AGENT_PORT=8000

# Public app URLs
PUBLIC_CLIENT_URL=https://app.example.com
PUBLIC_API_BASE_URL=https://api.example.com
PUBLIC_AGENT_BASE_URL=https://agent.example.com

# Server security
JWT_SECRET=REPLACE_WITH_64_PLUS_CHAR_RANDOM_SECRET
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
CORS_ALLOWED_ORIGINS=https://app.example.com

# MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DB_NAME=codflo
MONGO_MAX_POOL_SIZE=50

# AI/Agent service
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
AGENT_REQUEST_TIMEOUT_SECONDS=60

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Observability
ENABLE_METRICS=true
SENTRY_DSN=

# Infrastructure
NGINX_PORT=80
