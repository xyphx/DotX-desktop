<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DotX.Desktop.ViewModels"
             x:DataType="vm:LoginViewModel"
             x:Class="DotX.Desktop.Views.LoginView">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Background="{StaticResource BackgroundBrush}" MinHeight="600">
            <Border Classes="Card" MaxWidth="440" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="16,24" Padding="32,40" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                <StackPanel Spacing="24">
                    <!-- Logo -->
                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Image Source="/Assets/logo.png" Width="52" Height="52" />
                        <TextBlock Text="DotX" FontWeight="Bold" FontSize="32" VerticalAlignment="Center" Foreground="{StaticResource TextDarkBrush}"/>
                    </StackPanel>

                    <!-- Instructions -->
                    <TextBlock Text="Sign in to continue" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,8"/>
                    
                    <StackPanel Spacing="8" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto, *" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="• " FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                            <TextBlock Grid.Column="1" Text="Go to xyphx.com and log into the console." FontSize="13" Foreground="{StaticResource TextLightBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="• " FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                            <TextBlock Grid.Column="1" Text="Generate a new API key from your dashboard." FontSize="13" Foreground="{StaticResource TextLightBrush}" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto, *" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="• " FontWeight="Bold" Foreground="{StaticResource TextLightBrush}" />
                            <TextBlock Grid.Column="1" Text="Paste the key below to authenticate." FontSize="13" Foreground="{StaticResource TextLightBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>

                    <!-- Action Button to Open Web -->
                    <Button Classes="Outline" HorizontalAlignment="Stretch" Command="{Binding OpenConsoleCommand}" Padding="0,10">
                        <TextBlock Text="Open XyphX Console" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                    </Button>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,4"/>

                    <!-- API Key Input -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="API Key" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}"/>
                        <TextBox Text="{Binding ApiKey}" Watermark="Paste your API key here..." PasswordChar="•" FontSize="13" Padding="12" CornerRadius="6" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    </StackPanel>

                    <!-- Security PIN Input -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Security PIN" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}"/>
                        <TextBox Text="{Binding Password}" Watermark="Enter your 6-digit PIN..." PasswordChar="•" MaxLength="6" FontSize="13" Padding="12" CornerRadius="6" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                    </StackPanel>

                    <!-- Error Message Display -->
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Login Button -->
                    <Button Classes="Primary" Content="Login" HorizontalAlignment="Stretch" Padding="0,12" FontSize="14" FontWeight="Bold" Command="{Binding LoginCommand}" IsEnabled="{Binding !IsLoggingIn}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
