<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DotX.Desktop.Controls"
             xmlns:vm="using:DotX.Desktop.ViewModels.Pages"
             x:DataType="vm:DashboardHomeViewModel"
             x:Class="DotX.Desktop.Views.Pages.DashboardHomeView">
    <ScrollViewer>
        <Grid RowDefinitions="Auto, *" Margin="24,16">
            <!-- Header -->
            <controls:HeaderControl Grid.Row="0" />

            <!-- Content Area -->
            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <!-- Left Content -->
                <StackPanel Spacing="24" Margin="0,0,24,24" MinWidth="280" MaxWidth="900">
                    <controls:WizardStepsControl />
                    <controls:DocumentUploadControl DataContext="{Binding DocumentUpload}" />
                </StackPanel>

                <!-- Right Sidebar -->
                <StackPanel Spacing="24" MinWidth="260" MaxWidth="340" Margin="0,0,0,24">
                    <controls:ProjectProgressControl />
                    <controls:AgentsListControl DataContext="{Binding AgentsList}" />
                </StackPanel>
            </WrapPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
