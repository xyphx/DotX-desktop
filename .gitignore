.env
.env.*
!.env.dist
*.pem
*.key
*.crt

# ------------------------------
# Logs / Runtime
# ------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock

# ------------------------------
# Node (if added later)
# ------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------
# Python / FastAPI (agent)
# ------------------------------
__pycache__/
*.py[cod]
*$py.class
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.eggs/
*.egg-info/
build/
dist/
.venv/
venv/
agent/.venv/
agent/venv/

# ------------------------------
# Go (server)
# ------------------------------
bin/
*.test
*.out
coverage.out

# ------------------------------
# Flutter / Dart (client)
# Note: client/ already has its own .gitignore;
# these are root-level safety ignores.
# ------------------------------
.dart_tool/
.packages
.pub/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
client/build/
client/**/GeneratedPluginRegistrant.*

# ------------------------------
# Docker / Compose
# ------------------------------
*.tar
docker-data/

# ------------------------------
# Infra / Terraform (if added later)
# ------------------------------
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# ------------------------------
# Test / Coverage artifacts
# ------------------------------
coverage/
.nyc_output/

# ------------------------------
# Keep important tracked artifacts
# ------------------------------
!shared/models/*.json
